{
  "name": "warehouse-strike-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @warehouse-strike/shared build && pnpm --filter @warehouse-strike/server build && pnpm --filter @warehouse-strike/client build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"pnpm --filter @warehouse-strike/server dev\" \"pnpm --filter @warehouse-strike/client dev\"",
    "dev:server": "pnpm --filter @warehouse-strike/server dev",
    "dev:client": "pnpm --filter @warehouse-strike/client dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}

